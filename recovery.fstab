# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point   fstype  device									device2				flags
/boot			emmc	/dev/mmcblk0p12
/cache			ext4	/dev/mmcblk0p57
/data			ext4	/dev/mmcblk0p59								flags=encryptable=footer
/misc			emmc	/dev/mmcblk0p47
/recovery		emmc	/dev/mmcblk0p58								flags=backup=1
/system			ext4	/dev/mmcblk0p13
/system_image		emmc	/dev/mmcblk0p13
/vendor			ext4	/dev/mmcblk0p14
/vendor_image		emmc	/dev/mmcblk0p14
/efs1			emmc	/dev/mmcblk0p44								flags=backup=1;display=EFS
/efs2			emmc	/dev/mmcblk0p45								flags=backup=1;subpartitionof=/efs1
/efsg			emmc	/dev/mmcblk0p11								flags=backup=1;subpartitionof=/efs1
/efsc			emmc	/dev/mmcblk0p42								flags=backup=1;subpartitionof=/efs1

# Removable storage
/usb_otg		vfat	/dev/sda1							/dev/sda			flags=display="USB-OTG";storage;wipeingui;removable
